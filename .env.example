# ==========================================
# BACKEND (Render Web Service)
# ==========================================
# PostgreSQL connection string (Render PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require"

# Gemini AI API key (server-side only, never expose to frontend)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Allowed Firebase Hosting frontend origin(s), comma-separated
# Example: https://hidef-tempo-xkpm1.web.app,https://hidef-tempo-xkpm1.firebaseapp.com
FRONTEND_ORIGIN="https://hidef-tempo-xkpm1.web.app,https://hidef-tempo-xkpm1.firebaseapp.com"

# Firebase Project ID & Service Account JSON (required on Render backend)
FIREBASE_PROJECT_ID="hidef-tempo-xkpm1"
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Session / signing secret (generate random string in production)
SESSION_SECRET="CHANGE_ME_TO_A_RANDOM_SECRET"

# Optional Web Push VAPID keys (auto-generated & persisted in DB if omitted)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Optional legacy Cloud SQL / local Postgres vars (used if DATABASE_URL is unset)
SQL_HOST="127.0.0.1"
SQL_USER="postgres"
SQL_PASSWORD="MY_SQL_PASSWORD"
SQL_DB_NAME="postgres"

# ==========================================
# FRONTEND (Firebase Hosting build-time env)
# ==========================================
# Public URL of Render Web Service backend (no trailing slash)
# Example: https://brave-api.onrender.com
VITE_API_BASE_URL=""

# Optional Firebase client overrides (defaults to firebase-applet-config.json)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
