# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public HTTPS URL where this app is hosted.
APP_URL="MY_APP_URL"

# PostgreSQL connection variables (auto-injected by Cloud SQL in AI Studio)
SQL_HOST="127.0.0.1"
SQL_USER="postgres"
SQL_PASSWORD="MY_SQL_PASSWORD"
SQL_DB_NAME="postgres"

# Optional secret used to sign HttpOnly email login session cookies
SESSION_SECRET="CHANGE_ME_TO_A_RANDOM_SECRET"

# Optional VAPID keys for Web Push phone notifications (auto-generated & stored in DB if omitted)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
